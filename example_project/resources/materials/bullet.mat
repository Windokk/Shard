            "roughness": 1.0
        },
        {
            "useEnvReflections": true
        },
        {
            "metallicMap": "textures/bullet/Bullet_Metallic.png"
        },
        {
            "normalMap": "textures/bullet/Bullet_Normal.png"
        },
        {
            "roughnessMap": "textures/bullet/Bullet_Roughness.png"
        }
    ]
}