# The SDK outside the repository, for the sandbox : the template of sdk/templates/plugin built against the installed SDK alone with
# -DSHARD_PLUGIN_TARGET=wasm (a WebAssembly module and a tier 2 manifest), then loaded by the headless engine, which runs the simulation twice
# (--check-plugins). Variables : ENGINE_BUILD WORK GENERATOR MAKE_PROGRAM TOOLCHAIN BUILTINS HEADLESS GAME PROJECT WORKDIR
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --component sdk --prefix "${WORK}/install"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installing the SDK failed\n${out}\n${err}")
endif()
set(sdk "${WORK}/install/sdk")
if(NOT EXISTS "${sdk}/cmake/ShardSDKWasm.cmake" OR NOT EXISTS "${sdk}/include/shard/shard_wasm_imports.h")
    message(FATAL_ERROR "the installed SDK has no wasm support : ${sdk}")
endif()
file(COPY "${sdk}/templates/plugin/" DESTINATION "${WORK}/src")
set(configure "${CMAKE_COMMAND}" -S "${WORK}/src" -B "${WORK}/build" -G "${GENERATOR}" -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${sdk}"
    -DSHARD_PLUGIN_TARGET=wasm "-DSHARD_WASM_TOOLCHAIN=${TOOLCHAIN}" "-DSHARD_WASM_BUILTINS=${BUILTINS}")
if(MAKE_PROGRAM)
    list(APPEND configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
execute_process(COMMAND ${configure} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "configuring the template for wasm failed\n${out}\n${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "building the template for wasm failed\n${out}\n${err}")
endif()
set(plugin "${WORK}/build/plugins/com.example.template")
if(NOT EXISTS "${plugin}/plugin.wasm" OR NOT EXISTS "${plugin}/shard-plugin.json")
    message(FATAL_ERROR "no sandboxed plugin folder in ${WORK}/build/plugins")
endif()
file(READ "${plugin}/shard-plugin.json" manifest)
if(NOT manifest MATCHES "wasm1" OR NOT manifest MATCHES "\"tier\" *: *2")
    message(FATAL_ERROR "the manifest is not a tier 2, wasm1 one\n${manifest}")
endif()
execute_process(
    COMMAND "${HEADLESS}" --check-plugins --game "${GAME}" --project "${PROJECT}" --plugin "${plugin}" --frames 60
    WORKING_DIRECTORY "${WORKDIR}"
    OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result TIMEOUT 300)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "--check-plugins with the sandboxed template failed with ${result}\n${output}\n${errors}")
endif()
if(NOT "${output}${errors}" MATCHES "\\[com\\.example\\.template\\] loaded")
    message(FATAL_ERROR "the sandboxed template did not load\n${output}\n${errors}")
endif()
if(NOT output MATCHES "same state with 1 and [0-9]+ job threads")
    message(FATAL_ERROR "unexpected output\n${output}")
endif()
message(STATUS "the template, built to WebAssembly against the installed SDK, loaded and ran in the sandbox")
