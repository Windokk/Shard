#version 430 core
#extension GL_ARB_bindless_texture : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D uAccum;

uniform bool uWriteTerms;
layout(rgba32f, binding = 1) uniform image2D uAccumDirect;
layout(rgba32f, binding = 2) uniform image2D uAccumIndirectDiffuse;
layout(rgba32f, binding = 3) uniform image2D uAccumIndirectSpecular;
layout(rgba32f, binding = 4) uniform image2D uAccumEmission;

#include "../common/light.glsl"
#include "../common/raytracing_types.glsl"
#include "../common/normal_map.glsl"

layout(std430, binding = 0) readonly buffer BVHNodes       { BVHNode bvhNodes[]; };
layout(std430, binding = 1) readonly buffer TrianglePositions { TrianglePos triPos[]; };
layout(std430, binding = 2) readonly buffer TriangleAttribs   { TriangleAttrib triAttrib[]; };
layout(std430, binding = 3) readonly buffer Materials         { GPUMaterial materials[]; };
layout(std430, binding = 4) readonly buffer Lights            { Light lights[]; };

#include "../common/raytracing_trace.glsl"
#include "../common/path_tracing.glsl"

uniform vec3 uCameraPos;
uniform vec3 uCameraRight;
uniform vec3 uCameraUp;
uniform vec3 uCameraForward;
uniform bool uPanorama;
uniform vec2 uImageSize;
uniform vec2 uTileOffset;
uniform int  uFrameIndex;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + ivec2(uTileOffset);
    ivec2 imageSize = ivec2(uImageSize);
    if (pixel.x >= imageSize.x || pixel.y >= imageSize.y)
        return;

    rngState = PcgHash(PcgHash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u) + uint(uFrameIndex) * 26699u + 1u);

    vec2 jitter = RandomVec2();
    vec2 ndc = (vec2(pixel) + jitter) / uImageSize * 2.0 - 1.0;

    vec3 rd = normalize(uCameraForward + uCameraRight * ndc.x + uCameraUp * ndc.y);
    if (uPanorama) {
        // Layout read by equirectToCubemap.frag (u from atan(z, x), v from asin(y), v = 0 at the bottom), so the output loads as an environment map.
        vec2 uv = (vec2(pixel) + jitter) / uImageSize;
        float phi = (uv.x - 0.5) * 6.28318530718;
        float theta = (uv.y - 0.5) * 3.14159265359;
        rd = vec3(cos(theta) * cos(phi), sin(theta), cos(theta) * sin(phi));
    }
    vec3 ro = uCameraPos;

    vec3 traced = TracePath(ro, rd);
    vec3 sampleRadiance = ClampFirefly(traced);

    vec4 prev = uFrameIndex == 0 ? vec4(0.0) : imageLoad(uAccum, pixel);
    imageStore(uAccum, pixel, prev + vec4(sampleRadiance, 1.0));

    if (uWriteTerms)
    {
        float clampScale = dot(traced, vec3(1.0)) > 0.0 ? dot(sampleRadiance, vec3(1.0)) / dot(traced, vec3(1.0)) : 1.0;
        bool first = uFrameIndex == 0;
        imageStore(uAccumDirect, pixel, (first ? vec4(0.0) : imageLoad(uAccumDirect, pixel)) + vec4(gPathTerms[0] * clampScale, 0.0));
        imageStore(uAccumIndirectDiffuse, pixel, (first ? vec4(0.0) : imageLoad(uAccumIndirectDiffuse, pixel)) + vec4(gPathTerms[1] * clampScale, 0.0));
        imageStore(uAccumIndirectSpecular, pixel, (first ? vec4(0.0) : imageLoad(uAccumIndirectSpecular, pixel)) + vec4(gPathTerms[2] * clampScale, 0.0));
        imageStore(uAccumEmission, pixel, (first ? vec4(0.0) : imageLoad(uAccumEmission, pixel)) + vec4(gPathTerms[3] * clampScale, 0.0));
    }
}
