#version 430 core

// Culls point/spot lights into the Forward+ cluster grid built by cluster_build.comp (see
// LightCullingManager). One invocation per cluster: collects the lights whose bounding sphere overlaps
// that cluster's view-space AABB into LightGrid/LightIndexList, which mesh/lit.frag reads directly
// (bindings 2/3) instead of scanning every light in the scene.

layout(local_size_x = 64) in;

#include "../common/light.glsl"
#include "../common/cluster.glsl"

struct ClusterAABB { vec4 minPoint; vec4 maxPoint; };

layout(std430, binding = 0) readonly buffer LightBuffer { Light lights[]; };
layout(std430, binding = 1) readonly buffer ClusterAABBs { ClusterAABB clusters[]; };
layout(std430, binding = 2) writeonly buffer LightGrid { uvec2 lightGrid[]; };
layout(std430, binding = 3) writeonly buffer LightIndexList { uint lightIndices[]; };
layout(std430, binding = 5) buffer GlobalIndexCounter { uint globalIndexCount; };

uniform mat4 view;
uniform int lightCount;
uniform int gridSizeX;
uniform int gridSizeY;

// Conservative sphere-vs-AABB overlap test (Ericson, "Real-Time Collision Detection") - the exact spot
// cone test still happens per-fragment in lit.frag, this only needs to never exclude a light that could
// actually affect the cluster.
bool SphereIntersectsAABB(vec3 center, float radius, vec3 aabbMin, vec3 aabbMax)
{
    vec3 closest = clamp(center, aabbMin, aabbMax);
    vec3 d = center - closest;
    return dot(d, d) <= radius * radius;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint totalClusters = uint(gridSizeX) * uint(gridSizeY) * uint(CLUSTER_Z_SLICES);
    if (index >= totalClusters)
        return;

    vec3 aabbMin = clusters[index].minPoint.xyz;
    vec3 aabbMax = clusters[index].maxPoint.xyz;

    // Collected locally first so only one atomic reservation (below) is needed per cluster, instead of
    // one per matching light - capped at MAX_LIGHTS_PER_CLUSTER, which is also how LightIndexList is
    // sized (totalClusters * MAX_LIGHTS_PER_CLUSTER), so this cap is what keeps the reservation below
    // from ever exceeding the buffer's capacity.
    uint matched[MAX_LIGHTS_PER_CLUSTER];
    uint matchCount = 0u;

    for (int i = 0; i < lightCount && matchCount < uint(MAX_LIGHTS_PER_CLUSTER); ++i)
    {
        Light l = lights[i];
        if (l.type == 0) // Directional lights aren't clustered - see common/cluster.glsl
            continue;

        vec3 viewSpacePos = (view * vec4(l.position.xyz, 1.0)).xyz;

        if (SphereIntersectsAABB(viewSpacePos, l.radius, aabbMin, aabbMax))
        {
            matched[matchCount] = uint(i);
            ++matchCount;
        }
    }

    uint offset = 0u;
    if (matchCount > 0u)
        offset = atomicAdd(globalIndexCount, matchCount);

    lightGrid[index] = uvec2(offset, matchCount);

    for (uint k = 0u; k < matchCount; ++k)
        lightIndices[offset + k] = matched[k];
}
