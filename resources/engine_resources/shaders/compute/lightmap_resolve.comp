#version 430 core

// Turns the sums the baker accumulated into what the denoiser works on : per texel the mean of the samples (rgb) and the
// variance of that mean (a), which says how much of the picture is noise (see lightmap_atrous.comp). The variance of a mean of N
// samples is the variance of one sample over N ; the variance of one sample comes from the sum of their squared luminances
// the baker kept next to the sum of the samples (the mean of the squares, minus the square of the mean).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba32f, binding = 0) readonly uniform image2D uAccum;
layout(rgba32f, binding = 1) writeonly uniform image2D uOut;
layout(rgba32f, binding = 2) readonly uniform image2D uGPos;

uniform int uSize;
uniform float uSampleCount;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= uSize || texel.y >= uSize)
        return;

    if (imageLoad(uGPos, texel).w <= 0.0)
        return;

    vec4 acc = imageLoad(uAccum, texel);
    if (acc.a < 0.0)
    {
        imageStore(uOut, texel, vec4(0.0, 0.0, 0.0, -1.0));     // given up by the baker : stays marked
        return;
    }
    vec3 mean = acc.rgb / uSampleCount;

    // A few rare, very bright paths (fireflies) survive the per sample clamp, which has to stay high not to dim real highlights : in a
    // dark scene one of them alone outshines the whole mean of its texel, and the denoiser only spreads it. A texel much brighter than
    // every one of its neighbours is such a spike (a real edge of light has a bright neighbour on its side) : it is brought down to them.
    float neighbourMax = -1.0;
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            ivec2 tap = texel + ivec2(dx, dy);
            if ((dx == 0 && dy == 0) || tap.x < 0 || tap.y < 0 || tap.x >= uSize || tap.y >= uSize)
                continue;
            if (imageLoad(uGPos, tap).w <= 0.0)
                continue;
            vec4 tapAcc = imageLoad(uAccum, tap);
            if (tapAcc.a < 0.0)
                continue;
            neighbourMax = max(neighbourMax, dot(tapAcc.rgb, vec3(0.2126, 0.7152, 0.0722)) / uSampleCount);
        }
    }
    if (neighbourMax >= 0.0)
    {
        const float kSpikeRatio = 2.5;      // how much brighter than its brightest neighbour a texel may be
        float spikeLimit = neighbourMax * kSpikeRatio + 0.005;
        float meanLuminance = dot(mean, vec3(0.2126, 0.7152, 0.0722));
        if (meanLuminance > spikeLimit)
            mean *= spikeLimit / meanLuminance;
    }

    float lumMean = dot(mean, vec3(0.2126, 0.7152, 0.0722));
    float lumSquares = acc.a / uSampleCount;
    float variance = max(lumSquares - lumMean * lumMean, 0.0) / uSampleCount;

    imageStore(uOut, texel, vec4(mean, variance));
}
