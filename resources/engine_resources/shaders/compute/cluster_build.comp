#version 430 core

layout(local_size_x = 64) in;

#include "../common/cluster.glsl"

struct ClusterAABB { vec4 minPoint; vec4 maxPoint; };

layout(std430, binding = 1) writeonly buffer ClusterAABBs {
    ClusterAABB clusters[];
};

uniform mat4 invProjection;
uniform int gridSizeX;
uniform int gridSizeY;
uniform float nearPlane;
uniform float farPlane;
uniform vec2 screenSize;

vec3 ScreenToView(vec2 screenCoord)
{
    vec2 ndc = (screenCoord / screenSize) * 2.0 - 1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);
    vec4 view = invProjection * clip;
    view /= view.w;
    return view.xyz;
}

vec3 IntersectZPlane(vec3 point, float zDist)
{
    float t = zDist / point.z;
    return point * t;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint totalClusters = uint(gridSizeX) * uint(gridSizeY) * uint(CLUSTER_Z_SLICES);
    if (index >= totalClusters)
        return;

    uint tileX  = index % uint(gridSizeX);
    uint tileY  = (index / uint(gridSizeX)) % uint(gridSizeY);
    uint zSlice = index / (uint(gridSizeX) * uint(gridSizeY));

    float sliceNear = nearPlane * pow(farPlane / nearPlane, float(zSlice) / float(CLUSTER_Z_SLICES));
    float sliceFar  = nearPlane * pow(farPlane / nearPlane, float(zSlice + 1u) / float(CLUSTER_Z_SLICES));

    vec2 tileMinPx = vec2(tileX, tileY) * float(CLUSTER_TILE_PX);
    vec2 tileMaxPx = vec2(tileX + 1u, tileY + 1u) * float(CLUSTER_TILE_PX);

    vec3 c0 = ScreenToView(vec2(tileMinPx.x, tileMinPx.y));
    vec3 c1 = ScreenToView(vec2(tileMaxPx.x, tileMinPx.y));
    vec3 c2 = ScreenToView(vec2(tileMinPx.x, tileMaxPx.y));
    vec3 c3 = ScreenToView(vec2(tileMaxPx.x, tileMaxPx.y));

    vec3 nearP0 = IntersectZPlane(c0, -sliceNear);
    vec3 nearP1 = IntersectZPlane(c1, -sliceNear);
    vec3 nearP2 = IntersectZPlane(c2, -sliceNear);
    vec3 nearP3 = IntersectZPlane(c3, -sliceNear);

    vec3 farP0 = IntersectZPlane(c0, -sliceFar);
    vec3 farP1 = IntersectZPlane(c1, -sliceFar);
    vec3 farP2 = IntersectZPlane(c2, -sliceFar);
    vec3 farP3 = IntersectZPlane(c3, -sliceFar);

    vec3 minP = min(nearP0, min(nearP1, min(nearP2, min(nearP3,
                min(farP0, min(farP1, min(farP2, farP3)))))));
    vec3 maxP = max(nearP0, max(nearP1, max(nearP2, max(nearP3,
                max(farP0, max(farP1, max(farP2, farP3)))))));

    clusters[index].minPoint = vec4(minP, 0.0);
    clusters[index].maxPoint = vec4(maxP, 0.0);
}
