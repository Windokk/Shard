#version 430 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform readonly image2D uRayAtlas;

// Binding 14, not writeonly: this pass writes only .w and must leave .xyz (probe_relocate.comp) alone.
layout(std430, binding = 14) buffer ProbeState { vec4 probeState[]; };

uniform int uProbeCount;
uniform int uTileSize;
uniform int uAtlasProbesPerRow;

uniform int uUpdateStride;
uniform int uUpdatePhase;

#include "../../common/ddgi_atlas.glsl"

const float BACKFACE_RATIO_THRESHOLD = 0.5;

void main()
{
    int probeIndex = uUpdatePhase + int(gl_GlobalInvocationID.x) * uUpdateStride;
    if (probeIndex >= uProbeCount)
        return;

    ivec2 tileOrigin = DDGI_TileCorner(probeIndex, uTileSize, uAtlasProbesPerRow) + ivec2(1, 1);

    int backfaceCount = 0;
    int totalCount = uTileSize * uTileSize;

    for (int y = 0; y < uTileSize; y++)
    {
        for (int x = 0; x < uTileSize; x++)
        {
            float valid = imageLoad(uRayAtlas, tileOrigin + ivec2(x, y)).a;
            if (valid < 0.5)
                backfaceCount++;
        }
    }

    float backfaceRatio = float(backfaceCount) / float(totalCount);
    probeState[probeIndex].w = backfaceRatio > BACKFACE_RATIO_THRESHOLD ? 0.0 : 1.0;
}
