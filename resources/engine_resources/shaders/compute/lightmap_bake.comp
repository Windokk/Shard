#version 430 core
#extension GL_ARB_bindless_texture : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D uAccum;
layout(rgba32f, binding = 1) readonly uniform image2D uGPos;
layout(rgba16f, binding = 2) readonly uniform image2D uGNormal;
layout(rgba16f, binding = 3) readonly uniform image2D uGGeo;

#include "../common/light.glsl"
#include "../common/raytracing_types.glsl"
#include "../common/normal_map.glsl"

// Bindings below 8 belong to the forward pass (light buffer at 0 must not be replaced). Same 8-13 as the probe tracer.
layout(std430, binding = 8)  readonly buffer BVHNodes          { BVHNode bvhNodes[]; };
layout(std430, binding = 9)  readonly buffer TrianglePositions { TrianglePos triPos[]; };
layout(std430, binding = 10) readonly buffer TriangleAttribs   { TriangleAttrib triAttrib[]; };
layout(std430, binding = 11) readonly buffer Materials         { GPUMaterial materials[]; };
layout(std430, binding = 12) readonly buffer Lights            { Light lights[]; };
layout(std430, binding = 13) readonly buffer TexelList         { uint texelList[]; };

#define SHARD_EMISSIVE_NEE
layout(std430, binding = 16) readonly buffer EmissiveTriangles { EmissiveTriangle emissiveTris[]; };

#include "../common/raytracing_trace.glsl"
#include "../common/path_tracing.glsl"

uniform int uTexelOffset;
uniform int uTexelCount;
uniform int uSampleStart;
uniform int uSamples;
uniform int uSeed;
uniform float uIndirectScale;

vec3 DirectStaticLight(vec3 pos, vec3 ns, vec3 ng)
{
    vec3 sum = vec3(0.0);

    for (int li = 0; li < uLightCount; li++)
    {
        Light light = lights[li];
        if (light.bakeMode != LIGHT_BAKE_STATIC)
            continue;

        vec3 toLight;
        float dist;
        vec3 incoming = SampleLight(light, pos, RandomVec2(), toLight, dist);

        float NdotL = dot(ns, toLight);
        if (NdotL <= 0.0 || dot(ng, toLight) <= 0.0 || dot(incoming, vec3(1.0)) <= 0.0)
            continue;

        if (LightOccluded(light, pos, ng, toLight, dist))
            continue;

        sum += incoming * (NdotL / PI);
    }

    return sum;
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(uTexelCount))
        return;

    uint entry = texelList[uTexelOffset + int(gid)];
    ivec2 texel = ivec2(int(entry & 0xFFFFu), int(entry >> 16));

    vec4 posData = imageLoad(uGPos, texel);
    if (posData.w <= 0.0)
        return;

    vec3 pos = posData.xyz;
    vec3 ns = normalize(imageLoad(uGNormal, texel).xyz);
    vec3 ng = normalize(imageLoad(uGGeo, texel).xyz);

    vec3 origin = pos + ng * max(1e-3, posData.w * 0.05);

    vec4 acc = uSampleStart == 0 ? vec4(0.0) : imageLoad(uAccum, texel);

    // A texel inside a solid would bake dark and bleed into neighbours. It is given up (negative variance) and filled from valid neighbours at encode time.
    if (uSampleStart == 0)
    {
        const int kProbes = 16;
        int backfaces = 0;
        for (int i = 0; i < kProbes; i++)
        {
            rngState = PcgHash(PcgHash(uint(texel.x) * 2909u + uint(texel.y) * 6971u + uint(uSeed) * 4057u) + uint(i) * 40503u + 977u);
            vec3 rd = CosineSampleHemisphere(ns);
            float above = dot(rd, ng);
            if (above < 0.05)
                rd = normalize(rd + ng * (0.05 - above));

            HitInfo hit;
            if (TraceRay(origin, rd, 2.0, hit))
            {
                TriangleAttrib attrib = triAttrib[hit.triIndex];
                float w0 = 1.0 - hit.bary.x - hit.bary.y;
                vec3 hitNormal = attrib.n0.xyz * w0 + attrib.n1.xyz * hit.bary.x + attrib.n2.xyz * hit.bary.y;
                if (dot(hitNormal, rd) > 0.0)
                    backfaces++;
            }
        }

        if (backfaces * 2 > kProbes)
        {
            imageStore(uAccum, texel, vec4(0.0, 0.0, 0.0, -1.0));
            return;
        }
    }
    else if (acc.a < 0.0)
        return;

    for (int i = 0; i < uSamples; i++)
    {
        rngState = PcgHash(PcgHash(uint(texel.x) * 1973u + uint(texel.y) * 9277u + uint(uSeed) * 7919u) + uint(uSampleStart + i) * 26699u + 1u);

        vec3 rd = CosineSampleHemisphere(ns);
        float aboveGeometry = dot(rd, ng);
        if (aboveGeometry < 0.05)
            rd = normalize(rd + ng * (0.05 - aboveGeometry));

        vec3 indirect = TracePathMIS(origin, rd, ns, 1.0) + EmissiveDirect(pos, ng, ns, 1.0) / PI;
        vec3 sampleRadiance = ClampFirefly(indirect) * uIndirectScale + DirectStaticLight(pos, ns, ng);

        float lum = dot(sampleRadiance, vec3(0.2126, 0.7152, 0.0722));
        acc += vec4(sampleRadiance, lum * lum);
    }

    imageStore(uAccum, texel, acc);
}
